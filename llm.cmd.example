@echo off
rem Copy this file to llm.cmd, remove the "rem" from ONE option and paste your key.
rem llm.cmd is ignored by git, so your key is never committed.

rem ---- Option A: Google Gemini (free tier, key from https://aistudio.google.com/apikey) ----
rem set LLM_PROVIDER=gemini
rem set LLM_API_KEY=PASTE_YOUR_KEY_HERE
rem set LLM_MODEL=gemini-3.1-flash-lite

rem ---- Option B: Groq (free tier, key from https://console.groq.com/keys) ----
rem set LLM_PROVIDER=openai
rem set LLM_BASE_URL=https://api.groq.com/openai
rem set LLM_API_KEY=PASTE_YOUR_KEY_HERE
rem set LLM_MODEL=llama-3.3-70b-versatile

rem ---- Option C: Ollama, runs on your own PC, no key, no internet (install from https://ollama.com, then: ollama pull llama3.2) ----
rem set LLM_PROVIDER=openai
rem set LLM_BASE_URL=http://localhost:11434
rem set LLM_API_KEY=ollama
rem set LLM_MODEL=llama3.2
